+// Fade displacement at both edges of the lens band. The center stays stable.
+// The bound also scales with density because thickness is measured in pixels.
+float nebulaEdgeLimit(float sd, float thickness, float intensity) {
+  float edge = clamp(-sd / max(thickness, 1.0), 0.0, 1.0);
+  float envelope = smoothstep(0.0, 0.18, edge) * (1.0 - smoothstep(0.60, 1.0, edge));
+  return thickness * 0.35 * clamp(intensity * 2.0, 0.0, 1.0) * envelope;
+}
