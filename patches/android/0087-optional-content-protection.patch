     public static boolean isSecuredNow(Window window) {
+        // Единственное место, где ставится FLAG_SECURE. С включённым разрешением
+        // окно перестаёт быть защищённым — снимки экрана и запись снова работают.
+        if (app.nebulagram.ui.NebulaContentProtection.enabled()) {
