+    private void nebulaSelectAllLoadedMessages() {
+        if (!actionBar.isActionModeShowed() || isReport()) return;
+        for (MessageObject message : new ArrayList<>(messages)) {
+            if (selectedMessagesIds[0].size() + selectedMessagesIds[1].size() >= 100) break;
+            if (message == null || message.isDateObject || message.getId() == 0
+                    || message.isSending() || message.isEditing() || message.isAnyGift()
+                    || message.isWallpaperAction() || message.isSponsored() || message.isEphemeral()
+                    || message.type == MessageObject.TYPE_JOINED_CHANNEL || message.type == MessageObject.TYPE_GIFT_STARS) continue;
+            int type = getMessageType(message);
+            if (type < 2 || type == 20 || type == MessageObject.TYPE_SUGGEST_PHOTO) continue;
+            int index = message.getDialogId() == dialog_id ? 0 : 1;
+            if (selectedMessagesIds[index].get(message.getId()) == null) {
+                addToSelectedMessages(message, false, false);
+            }
+        }
+        addToSelectedMessages(null, false, true);
+        updateActionModeTitle();
+        updateVisibleRows();
+        updateSelectedMessageReactions();
+    }
