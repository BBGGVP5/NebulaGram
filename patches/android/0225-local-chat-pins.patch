+    /** Read-only peer-dialog hydration for this device's additional pin order. */
+    public void applyNebulaLocalPinDialogs(TLRPC.TL_messages_peerDialogs response) {
+        final long owner = getUserConfig().getClientUserId();
+        if (owner == 0) return;
+        getMessagesStorage().getStorageQueue().postRunnable(() -> {
+            try {
+                // Hydration must not reset a cached native pin number or race
+                // a freshly loaded/pinned dialog. Existing DB rows are not replaced.
+                for (TLRPC.Dialog dialog : response.dialogs) {
+                    long id = DialogObject.getPeerDialogId(dialog.peer);
+                    org.telegram.SQLite.SQLiteCursor cursor = getMessagesStorage().getDatabase().queryFinalized("SELECT pinned FROM dialogs WHERE did = " + id);
+                    try { if (cursor.next()) { dialog.pinnedNum = cursor.intValue(0); dialog.pinned = dialog.pinnedNum != 0; } }
+                    finally { cursor.dispose(); }
+                }
+                AndroidUtilities.runOnUIThread(() -> {
+                    if (getUserConfig().getClientUserId() != owner) return;
+                    java.util.HashMap<Integer, TLRPC.TL_messages_dialogs> groups = new java.util.HashMap<>();
+                    for (TLRPC.Dialog dialog : response.dialogs) {
+                        if (dialog.top_message == 0 || dialog.folder_id < 0 || dialog.folder_id > 1) continue;
+                        TLRPC.TL_messages_dialogs group = groups.computeIfAbsent(dialog.folder_id, key -> new TLRPC.TL_messages_dialogs());
+                        group.dialogs.add(dialog);
+                    }
+                    for (java.util.Map.Entry<Integer, TLRPC.TL_messages_dialogs> entry : groups.entrySet()) {
+                        TLRPC.TL_messages_dialogs group = entry.getValue();
+                        group.users.addAll(response.users); group.chats.addAll(response.chats);
+                        java.util.HashSet<Long> ids = new java.util.HashSet<>();
+                        for (TLRPC.Dialog dialog : group.dialogs) ids.add(DialogObject.getPeerDialogId(dialog.peer));
+                        for (TLRPC.Message message : response.messages) if (ids.contains(MessageObject.getDialogId(message))) group.messages.add(message);
+                        processLoadedDialogs(group, null, null, entry.getKey(), 0, group.dialogs.size(), DIALOGS_LOAD_TYPE_NEBULA_LOCAL_PINS, false, false, false);
+                    }
+                });
+            } catch (Exception failure) { FileLog.e(failure); }
+        });
+    }
