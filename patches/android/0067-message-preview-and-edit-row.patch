+        @Override
+        protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
+            int visible = 0;
+            for (EditViewButton button : buttons) {
+                if (button != null && button.getVisibility() != GONE) visible++;
+            }
+            boolean glass = app.nebulagram.ui.NebulaAppearance.iosComposer()
+                    && MeasureSpec.getMode(widthMeasureSpec) != MeasureSpec.UNSPECIFIED;
+            int available = Math.max(0, MeasureSpec.getSize(widthMeasureSpec) - getPaddingLeft() - getPaddingRight());
+            for (int i = 0; i < buttons.length; i++) {
+                EditViewButton button = buttons[i];
+                if (button == null) continue;
+                LayoutParams params = (LayoutParams) button.getLayoutParams();
+                boolean label = button.getTextView() != null && button.getTextView().getVisibility() != GONE;
+                params.width = glass && label ? available / Math.max(1, visible) : LayoutParams.WRAP_CONTENT;
+                if (label) button.getTextView().setMaxWidth(glass
+                        ? Math.max(0, params.width - button.getPaddingLeft() - button.getPaddingRight() - org.telegram.messenger.AndroidUtilities.dp(34))
+                        : i == 0 && button.isEditButton() ? org.telegram.messenger.AndroidUtilities.dp(116) : Integer.MAX_VALUE);
+            }
+            super.onMeasure(widthMeasureSpec, heightMeasureSpec);
+        }
