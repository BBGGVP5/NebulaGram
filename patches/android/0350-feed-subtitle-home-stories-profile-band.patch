     public int getNebulaHomeVisibleStories() { return nebulaHomeVisibleStories; }
 
+    /**
+     * Сколько аватарок помещается рядом с заголовком прямо сейчас. Замер решает это
+     * один раз, а текст заголовка («Подключение к NebulaLink…») меняется и без
+     * нового замера, и стопка из трёх аватарок наезжала на начало длинного
+     * заголовка. Здесь считается по полной ширине текущего текста.
+     */
+    private int nebulaHomeLiveStories() {
+        int visible = nebulaHomeVisibleStories;
+        if (!nebulaHomeLayout || visible <= 0 || getMeasuredWidth() == 0) return visible;
+        int title = 0;
+        for (SimpleTextView view : titleTextView) {
+            if (view == null || view.getVisibility() == GONE || view.getAlpha() <= 0f || view.getText() == null) continue;
+            CharSequence text = view.getText();
+            int width = (int) Math.ceil(view.getTextPaint().measureText(text, 0, text.length()))
+                    + view.getSideDrawablesSize() + view.getPaddingLeft() + view.getPaddingRight();
+            title = Math.max(title, width);
+        }
+        int available = getMeasuredWidth() - dp(84) - nebulaTitleEndInset();
+        return Math.min(visible, app.nebulagram.ui.NebulaHomeTitleGeometry.visibleStories(
+                nebulaHomeStoryCount, available, title, dp(34), dp(16), dp(8)));
+    }
+
+    /** Перед отрисовкой: стопка не шире, чем оставляет текущий текст заголовка. */
+    private void nebulaClampHomeStories() {
+        int live = nebulaHomeLiveStories();
+        if (live == nebulaHomeVisibleStories) return;
+        nebulaHomeVisibleStories = live;
+        updateNebulaHomeTitleLayout();
+    }
+
     private int nebulaHomeStoryPrefix() {
         return app.nebulagram.ui.NebulaHomeTitleGeometry.storyPrefix(
