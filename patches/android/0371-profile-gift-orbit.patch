+    /** NebulaGram: подарки в стеклянных пузырях летают по орбите и пульсируют под песню профиля. */
+    private void nebulaDrawOrbit(Canvas canvas, float acx, float acy, float aw, float ah, float realCX, float realCY, float expandScale, float closedAlpha) {
+        final double seconds = android.os.SystemClock.uptimeMillis() / 1000.0;
+        final float bubble = dp(21);
+        final float rx = Math.min(aw / 2f + dp(64) * Math.max(.6f, expandScale), getWidth() / 2f - bubble - dp(6));
+        final float ry = ah / 2f + dp(24) * Math.max(.6f, expandScale);
+        final int count = gifts.size();
+        boolean visible = false;
+        nebulaOrbitOrder.clear();
+        nebulaOrbitOrder.addAll(gifts);
+        // Дальние пузыри рисуются первыми, ближние поверх них.
+        java.util.Collections.sort(nebulaOrbitOrder, (a, b) -> Float.compare(nebulaDepth(a, count, seconds), nebulaDepth(b, count, seconds)));
+        for (int k = 0; k < nebulaOrbitOrder.size(); ++k) {
+            final Gift gift = nebulaOrbitOrder.get(k);
+            final int index = gifts.indexOf(gift);
+            final float enter = gift.animatedFloat.set(1.0f);
+            final float alphaBase = enter * (1.0f - expandProgress) * (1.0f - actionBarProgress) * closedAlpha;
+            app.nebulagram.ui.NebulaGiftOrbit.orbit(index, count, seconds, acx, acy, rx, ry, dp(5), nebulaOrbitPoint);
+            float gx = nebulaOrbitPoint[0], gy = nebulaOrbitPoint[1];
+            final float depth = nebulaOrbitPoint[2];
+            float scale = lerp(0.5f, 1.0f, enter) * lerp(.84f, 1.06f, depth);
+            float alpha = alphaBase * lerp(.78f, 1f, depth);
+
+            final float collapseProgressWithEnter = isOpening || enter >= 1f ? collapseProgress : Math.min(enter, collapseProgress);
+            final float collapse = Utilities.clamp01((collapseProgressWithEnter - index * .06f) / (1f - Math.min(.4f, count * .06f)));
+            if (collapse < 1f) {
+                gx = lerp(realCX, gx, giftCollapseXInterpolator.getInterpolation(collapse));
+                gy = lerp(realCY, gy, giftCollapseYInterpolator.getInterpolation(collapse));
+                scale = lerp(scale / 2f, scale, collapse);
+            }
+            if (alpha <= 0f) continue;
+            visible = true;
+            float pulse = 0f;
+            if (gift.nebulaBubble != null) {
+                pulse = gift.nebulaBubble.step(index);
+                gift.nebulaBubble.draw(canvas, gx, gy, bubble * scale * (1f + .16f * pulse) * gift.bounce.getScale(0.1f), seconds + index * 3.1, alpha);
+            }
+            gift.draw(canvas, gx, gy, scale * (1f + .12f * pulse), 0, alpha, 0f);
+        }
+        if (visible) {
+            postInvalidateOnAnimation();
+        }
