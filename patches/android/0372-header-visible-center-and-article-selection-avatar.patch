+    private boolean nebulaCenterVisibleWidth;
+
+    /**
+     * NebulaGram: centre what is actually drawn — the inside left icon, the
+     * text and every right icon — instead of the text alone. The offset is
+     * taken at draw time from the current drawables, so an icon that arrives
+     * or leaves after the last measure cannot pull the line off-centre.
+     */
+    public void setNebulaCenterVisibleWidth(boolean value) {
+        if (nebulaCenterVisibleWidth == value) {
+            return;
+        }
+        nebulaCenterVisibleWidth = value;
+        invalidate();
+    }
+
+    private void nebulaApplyVisibleCenter() {
+        if (!nebulaCenterVisibleWidth || layout == null || layout.getLineCount() == 0
+                || (gravity & Gravity.HORIZONTAL_GRAVITY_MASK) != Gravity.CENTER_HORIZONTAL) {
+            return;
+        }
+        final int lead = leftDrawable != null && !leftDrawableOutside ? drawablePadding + leftDrawable.getIntrinsicWidth() : 0;
+        int visible = lead + textWidth;
+        if (rightDrawable != null && (rightDrawableOutside || !rightDrawableInside && !rightDrawableHidden && rightDrawableScale > 0)) {
+            visible += drawablePadding + (int) (rightDrawable.getIntrinsicWidth() * rightDrawableScale);
+        }
+        if (rightDrawable2 != null && (rightDrawableOutside || !rightDrawableInside && !rightDrawableHidden && rightDrawableScale > 0)) {
+            visible += drawablePadding + (int) (rightDrawable2.getIntrinsicWidth() * rightDrawableScale);
+        }
+        final int available = getMeasuredWidth() - getPaddingLeft() - getPaddingRight();
+        // Text longer than its own slot (icons excluded) runs as a marquee from the start.
+        final boolean fits = visible <= available && lead + textWidth <= getMaxTextWidth() - getPaddingLeft() - getPaddingRight();
+        offsetX = getPaddingLeft() - (int) layout.getLineLeft(0) + (fits ? (available - visible) / 2 : 0);
+    }
