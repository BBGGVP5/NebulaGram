+    private boolean nebulaCheckBoxTranslationLimited;
+
+    /**
+     * NebulaGram: a wide rich message (tables, articles) used to drop the
+     * whole selection shift once it could not move the full 35dp. It now moves
+     * as far as the screen edge allows, and reports the limit so the chat does
+     * not borrow the full shift of the sender's previous message for this
+     * message's avatar, which then landed on top of the bubble's first line.
+     */
+    private int nebulaLimitCheckBoxTranslation(int translation) {
+        nebulaCheckBoxTranslationLimited = false;
+        if (currentMessageObject == null || currentMessageObject.type != MessageObject.TYPE_ARTICLE) {
+            return translation;
+        }
+        final int room = Math.max(0, getWidth() - getCurrentBackgroundRight());
+        if (translation <= room) {
+            return translation;
+        }
+        nebulaCheckBoxTranslationLimited = true;
+        return room;
+    }
+
+    /** The avatar must follow this cell's own (limited) shift, not a neighbour's. */
+    public boolean isNebulaCheckBoxTranslationLimited() {
+        return nebulaCheckBoxTranslationLimited && (checkBoxVisible || checkBoxAnimationInProgress);
+    }
