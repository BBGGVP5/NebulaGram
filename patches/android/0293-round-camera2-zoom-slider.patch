+
+    private void updateNebulaZoomSlider(boolean cameraControls) {
+        if (nebulaZoomSlider == null) return;
+        float maximum = nebulaMaximumZoom();
+        if (!cameraControls || maximum <= 1.01f) {
+            // Во время переключения камеры ползунок не прячем: прыжок раздражает.
+            if (!cameraFlipInProgress || !isRecordingState()) nebulaZoomSlider.setVisibility(View.GONE);
+            return;
+        }
+        nebulaZoomSlider.setRange(1f, maximum);
+        nebulaZoomSlider.setCameraFacing(capabilities.getActiveFacing() == RoundVideoSession.CameraFacing.FRONT);
+        nebulaZoomSlider.setCameraStops(new float[]{1f});
+        syncNebulaZoomSlider();
+        nebulaZoomSlider.setVisibility(View.VISIBLE);
+    }
+
+    private void syncNebulaZoomSlider() {
+        if (nebulaZoomSlider == null) return;
+        float maximum = nebulaMaximumZoom();
+        nebulaZoomSlider.setCurrent(1f + zoomProgress * Math.max(0f, maximum - 1f));
+    }
+
+    private void applyNebulaZoom(float factor) {
+        if (session == null || stateInfo == null || !stateInfo.canControlCamera()) return;
+        if (Float.isNaN(factor) || Float.isInfinite(factor)) return;
+        float maximum = nebulaMaximumZoom();
+        if (maximum <= 1f) return;
+        if (zoomResetAnimator != null) zoomResetAnimator.cancel();
+        zoomProgress = clamp((factor - 1f) / (maximum - 1f), 0f, 1f);
+        session.setZoom(zoomProgress);
+        nebulaZoomSlider.setCurrent(factor);
+    }
