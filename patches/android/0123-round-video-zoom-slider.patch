+    private void updateNebulaZoomSlider() {
+        if (!recording || !isCameraSessionInitiated()) {
+            nebulaZoomSlider.setVisibility(View.GONE);
+            return;
+        }
+        float max = useCamera2 && camera2SessionCurrent != null ? camera2SessionCurrent.getMaxZoom() : 2f;
+        if (max <= 1f) {
+            nebulaZoomSlider.setVisibility(View.GONE);
+            return;
+        }
+        nebulaZoomSlider.setRange(max);
+        nebulaZoomSlider.setVisibility(View.VISIBLE);
+    }
+
+    private void applyNebulaZoom(float factor) {
+        if (!recording || !isCameraSessionInitiated()) return;
+        if (useCamera2) {
+            if (camera2SessionCurrent != null) camera2SessionCurrent.setZoom(factor);
+        } else if (cameraSession != null) {
+            cameraSession.setZoom(Math.min(1f, Math.max(0f, factor - 1f)));
+        }
+    }
