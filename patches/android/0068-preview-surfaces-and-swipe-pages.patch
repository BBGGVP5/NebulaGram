+    private boolean prepareNebulaAlbumMenu(View view, boolean single, boolean listView,
+            float x, float y, boolean searchGroup, boolean longpress, boolean suggestEdit) {
+        if (single || nebulaAlbumMenuReady || !app.nebulagram.ui.NebulaAppearance.messageMenuBlur()
+                || !(view instanceof ChatMessageCell) || chatListView == null) return false;
+        ChatMessageCell cell = (ChatMessageCell) view;
+        MessageObject.GroupedMessages group = cell.getCurrentMessagesGroup();
+        if (group == null || group.isDocuments || group.messages.size() < 2) return false;
+        if (nebulaAlbumLayoutListener != null) return true;
+        final MessageObject selected = cell.getMessageObject();
+        // Layout all album rows before reading their bounds. A caption can remain
+        // attached after RecyclerView has recycled the photographs above it.
+        int rows = 1;
+        for (MessageObject.GroupedMessagePosition position : group.posArray) {
+            rows = Math.max(rows, position.maxY + 1);
+        }
+        float[] heights = new float[rows];
+        for (MessageObject.GroupedMessagePosition position : group.posArray) {
+            for (int row = position.minY; row <= position.maxY; row++) {
+                int index = row - position.minY;
+                float height = position.siblingHeights != null && index < position.siblingHeights.length
+                        ? position.siblingHeights[index] : position.ph / (position.maxY - position.minY + 1);
+                heights[row] = Math.max(heights[row], height);
+            }
+        }
+        float albumHeight = dp(12) * rows;
+        float unit = Math.max(chatListView.getWidth(), AndroidUtilities.displaySize.y) * .5f;
+        for (float height : heights) albumHeight += unit * height;
+        nebulaAlbumExtraSpace = Math.max(chatListView.getHeight(), (int) Math.ceil(albumHeight) + cell.getMeasuredHeight());
+        final int request = ++nebulaAlbumRequest;
+        nebulaAlbumLayoutListener = new View.OnLayoutChangeListener() {
+            @Override
+            public void onLayoutChange(View v, int l, int t, int r, int b, int ol, int ot, int or, int ob) {
+                v.removeOnLayoutChangeListener(this);
+                nebulaAlbumLayoutListener = null;
+                // Leave RecyclerView's layout transaction before creating a popup.
+                v.post(() -> {
+                    if (request != nebulaAlbumRequest) return;
+                    if (!cell.isAttachedToWindow() || cell.getMessageObject() != selected || paused) {
+                        clearNebulaAlbumPreview();
+                        return;
+                    }
+                    nebulaAlbumMenuReady = true;
+                    try {
+                        createMenu(view, single, listView, x, y, searchGroup, longpress, suggestEdit);
+                    } finally {
+                        nebulaAlbumMenuReady = false;
+                        if (scrimPopupWindow == null) clearNebulaAlbumPreview();
+                    }
+                });
+            }
+        };
+        chatListView.addOnLayoutChangeListener(nebulaAlbumLayoutListener);
+        chatListView.requestLayout();
+        return true;
+    }
