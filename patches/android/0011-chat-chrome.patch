+
+    private void updateNebulaAvatarLayout() {
+        if (nebulaChatAvatarContainer == null) return;
+        FrameLayout.LayoutParams params = (FrameLayout.LayoutParams) nebulaChatAvatarContainer.getLayoutParams();
+        if (params == null) return;
+        if (nebulaFloatingChatHeader) {
+            if (nebulaAvatarWidth == Integer.MIN_VALUE) {
+                nebulaAvatarWidth = params.width;
+                nebulaAvatarLeftMargin = params.leftMargin;
+                nebulaAvatarRightMargin = params.rightMargin;
+            }
+            params.width = ViewGroup.LayoutParams.MATCH_PARENT;
+            // The title capsule is centred in the full bar.  Symmetric small
+            // margins keep the original avatar at the trailing edge instead
+            // of placing it inside the title capsule.
+            params.leftMargin = dp(8);
+            params.rightMargin = dp(8);
+            nebulaChatAvatarContainer.setNebulaCenteredTitle(true);
+            nebulaChatAvatarContainer.setLayoutParams(params);
+        } else {
+            restoreNebulaAvatarLayout();
+        }
+        requestLayout();
+    }
+
+    private void restoreNebulaAvatarLayout() {
+        if (nebulaChatAvatarContainer == null || nebulaAvatarWidth == Integer.MIN_VALUE) return;
+        FrameLayout.LayoutParams params = (FrameLayout.LayoutParams) nebulaChatAvatarContainer.getLayoutParams();
+        if (params != null) {
+            params.width = nebulaAvatarWidth;
+            params.leftMargin = nebulaAvatarLeftMargin;
+            params.rightMargin = nebulaAvatarRightMargin;
+            nebulaChatAvatarContainer.setNebulaCenteredTitle(false);
+            nebulaChatAvatarContainer.setLayoutParams(params);
+        }
+        nebulaAvatarWidth = Integer.MIN_VALUE;
+    }
