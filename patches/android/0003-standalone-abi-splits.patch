+    // NebulaGram: по одному APK на архитектуру вместо одного общего. Ядро
+    // туннеля добавляет ~11 МБ нативного кода на каждую ABI, и в общем файле
+    // пользователь качал бы четыре копии ради одной.
+    def nebulaAbiCodes = ["armeabi-v7a": 1, "arm64-v8a": 2, "x86": 3, "x86_64": 4]
+
+    // AGP не разрешает ndk.abiFilters одновременно с abi splits, а флейвор afat
+    // их объявляет. Очищаем коллекцию вместо правки строк апстрима — так патч
+    // остаётся вставкой и не конфликтует при обновлении.
+    productFlavors.afat.ndk.abiFilters.clear()
+
+    splits {
+        abi {
+            enable true
+            reset()
+            include "armeabi-v7a", "arm64-v8a", "x86", "x86_64"
+            universalApk false
+        }
+    }
+
