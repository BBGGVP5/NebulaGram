+    // NebulaGram: по одному APK на архитектуру вместо одного общего. Ядро
+    // туннеля добавляет ~11 МБ нативного кода на каждую ABI, и в общем файле
+    // пользователь качал бы четыре копии ради одной.
+    def nebulaAbiCodes = ["armeabi-v7a": 1, "arm64-v8a": 2, "x86": 3, "x86_64": 4]
+
+    // AGP не разрешает ndk.abiFilters одновременно с abi splits, а флейвор afat
+    // их объявляет. Очищаем коллекцию вместо правки строк апстрима — так патч
+    // остаётся вставкой и не конфликтует при обновлении.
+    productFlavors.afat.ndk.abiFilters.clear()
+
+    // Апстрим добавляет sideload-сборке суффикс ".web", чтобы отличать её от
+    // магазинной. Форку это не нужно, а лишний суффикс ломает и Firebase, и
+    // ожидания пользователя: пакет должен совпадать с тем, что заведено в
+    // проекте Firebase, иначе токен для пушей не выдаётся.
+    buildTypes.standalone.applicationIdSuffix = ""
+
+    // Выключатель минификации для диагностики. R8 выбрасывает код, на который
+    // не видит ссылок, и отличить его работу от нашей ошибки можно только
+    // сборкой без него: -PnebulaMinify=false.
+    buildTypes.standalone.minifyEnabled =
+            Boolean.parseBoolean((project.findProperty("nebulaMinify") ?: "true").toString())
+
+    // Набор архитектур задаётся снаружи: сборка одной вместо четырёх занимает
+    // четверть времени, а для проверки изменения этого достаточно. Без
+    // параметра собираются все, поэтому релиз ничего не теряет.
+    def nebulaAbis = (project.findProperty("nebulaAbis")
+            ?: "armeabi-v7a,arm64-v8a,x86,x86_64").toString().split(",").collect { it.trim() }
+
+    splits {
+        abi {
+            enable true
+            reset()
+            include(*nebulaAbis)
+            universalApk false
+        }
+    }
+
     defaultConfig.versionCode = Integer.parseInt(APP_VERSION_CODE)
 
