 public func chatListViewForLocation(chatListLocation: ChatListControllerLocation, location: ChatListNodeLocation, account: Account, shouldLoadCanMessagePeer: Bool) -> Signal<ChatListNodeViewUpdate, NoError> {
+    guard case let .chatList(groupId) = chatListLocation else {
+        return nebulaNativeChatListViewForLocation(chatListLocation: chatListLocation, location: location, account: account, shouldLoadCanMessagePeer: shouldLoadCanMessagePeer)
+    }
+    let group = groupId._asGroup()
+    var originalPredicate: ChatListFilterPredicate?
+    var filterId: Int32?
+    if let filter = location.filter, case let .filter(id, _, _, data) = filter {
+        filterId = id
+        originalPredicate = chatListFilterPredicate(filter: data, accountPeerId: account.peerId)
+    }
+    let scope = NebulaLocalPins.scope(group: group, filterId: filterId)
+    return NebulaLocalPins.changes
+    |> mapToSignal { _ -> Signal<ChatListNodeViewUpdate, NoError> in
+        let state = NebulaLocalPins.snapshot(account: account)
+        let base = nebulaNativeChatListViewForLocation(chatListLocation: chatListLocation, location: location, account: account, shouldLoadCanMessagePeer: shouldLoadCanMessagePeer)
+        guard state.enabled, !(state.orders[scope] ?? []).isEmpty else { return base }
+        // Only an enabled nonempty scope adds a dependency view. Rebuild the
+        // projected view when pin membership changes, never for every message.
+        let pins = base
+        |> mapToSignal { _ -> Signal<[PeerId], NoError> in
+            return account.postbox.transaction { transaction -> [PeerId] in
+                let native: [PeerId]
+                if let predicate = originalPredicate { native = predicate.pinnedPeerIds }
+                else { native = transaction.getPinnedItemIds(groupId: group).map { item in switch item { case let .peer(peer): return peer } } }
+                return NebulaLocalPins.projectedPins(transaction: transaction, accountPeerId: account.peerId, group: group, filterId: filterId, native: native, excluded: originalPredicate?.excludePeerIds ?? [])
+            }
+        }
+        |> distinctUntilChanged
+        return pins |> mapToSignal { ids -> Signal<ChatListNodeViewUpdate, NoError> in
+            var predicate = originalPredicate ?? ChatListFilterPredicate(includePeerIds: [], excludePeerIds: [], pinnedPeerIds: [], messageTagSummary: nil, includeAdditionalPeerGroupIds: [], include: { _, _, _, _, _ in true })
+            predicate.pinnedPeerIds = ids
+            if originalPredicate == nil { predicate.nebulaGroupOnly = group; predicate.nebulaKeepsRootItems = true }
+            return nebulaNativeChatListViewForLocation(chatListLocation: chatListLocation, location: location, account: account, shouldLoadCanMessagePeer: shouldLoadCanMessagePeer, predicateOverride: predicate)
+        }
+    }
+}
