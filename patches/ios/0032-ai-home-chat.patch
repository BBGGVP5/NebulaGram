+
+/// Значок ярлыка Nebula AI для кнопки панели навигации.
+///
+/// Системный символ, а не ресурс приложения: он подхватывает начертание и
+/// толщину как остальные значки панели. Отрисовка шаблоном обязательна —
+/// иначе панель не покрасит его в свой цвет.
+private func nebulaAiShortcutImage() -> UIImage {
+    let configuration = UIImage.SymbolConfiguration(pointSize: 22.0, weight: .medium)
+    if let image = UIImage(systemName: "sparkles", withConfiguration: configuration) {
+        return image.withRenderingMode(.alwaysTemplate)
+    }
+    return UIImage(bundleImageName: "Chat List/AddStoryIcon") ?? UIImage()
+}
