+    private func nebulaUpdateTabBarScroll(offset: ListViewVisibleContentOffset, listView: ListView) {
+        guard let controller = self.controller, let tabBarController = controller.parent as? TabBarController else {
+            return
+        }
+        let transition: ContainedViewLayoutTransition = .animated(duration: 0.3, curve: .spring)
+        guard NebulaTabScroll.enabled(), !controller.isSearchActive else {
+            if self.nebulaTabScroll.hidden {
+                self.nebulaTabScroll.reset()
+                if !controller.isSearchActive {
+                    tabBarController.updateIsTabBarHidden(false, transition: transition)
+                }
+            }
+            self.nebulaLastListOffset = nil
+            return
+        }
+        var current: CGFloat?
+        var atTop = false
+        switch offset {
+        case let .known(value):
+            current = value
+            atTop = value <= 0.0
+        case .none:
+            atTop = true
+        case .unknown:
+            break
+        }
+        let dy = current.flatMap { value in self.nebulaLastListOffset.map { value - $0 } } ?? 0.0
+        self.nebulaLastListOffset = current
+        let manual = listView.isTracking || listView.isDragging || listView.isDeceleratingAfterTracking
+        if self.nebulaTabScroll.scrolled(dy: Double(dy), atTop: atTop, manual: manual) {
+            tabBarController.updateIsTabBarHidden(self.nebulaTabScroll.hidden, transition: transition)
+        }
+    }
