+
+// NebulaGram "Blurred messages": bubbles show the blurred wallpaper under a translucent
+// tint of their own colour. Keys are written by NebulaMessagePreferences; plain colour
+// wallpapers have nothing to blur, so their bubbles stay solid.
+private func nebulaBlurredBubbles() -> Bool {
+    return UserDefaults.standard.bool(forKey: "nebula.messages.message_blur")
+}
+
+private func nebulaBlurTint(_ color: UIColor) -> UIColor {
+    var percent = UserDefaults.standard.integer(forKey: "nebula.messages.message_blur_tint")
+    if ![35, 55, 75].contains(percent) {
+        percent = 55
+    }
+    return color.withAlphaComponent(color.cgColor.alpha * CGFloat(percent) / 100.0)
+}
