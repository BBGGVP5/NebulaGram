+        case .dev: details = isRussian ? "Значок для участников, которые помогают создавать NebulaGram." : "A badge for people who help build NebulaGram."
+        case .tester: details = isRussian ? "Значок для участников, которые помогают проверять новые версии NebulaGram." : "A badge for people who help test new NebulaGram releases."
+        case .star: details = isRussian ? "Особый значок сообщества NebulaGram." : "A special NebulaGram community badge."
+        case .heart: details = isRussian ? "Значок для друзей проекта, которые поддерживают NebulaGram." : "A badge for friends of the project who support NebulaGram."
+        }
+        let overlay = UndoOverlayController(presentationData: presentationData, content: .universal(animation: "anim_gift", scale: 0.075, colors: [:], title: badgeTitle, text: toastText, customUndoText: isRussian ? "Подробнее" : "Learn more", timeout: 6.0), elevatedLayout: false, position: .bottom, action: { [weak self] action in
+            guard case .undo = action, let self = self, let controller = self.controller else { return false }
