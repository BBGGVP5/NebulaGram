 public final class ChatRecordingPreviewInputPanelNodeImpl: ChatInputPanelNode {
+    private let nebulaAaNode = ASButtonNode()
+    private let nebulaDraftFetch = MetaDisposable()
+    private var nebulaDraftGeneration = 0
+    private var nebulaDraftFetching = false
+    private var nebulaDraftTranscript: (generation: Int, service: String, text: String)?
+
+    private func nebulaDraftServiceKey() -> String {
+        let audio = NebulaAudioPreferences.shared
+        return audio.transcriptionService + "|" + audio.transcriptionLocale
+    }
+
+    @objc private func nebulaAaPressed() {
+        guard !self.nebulaDraftFetching, NebulaAudioPreferences.shared.draftTranscriptionEnabled,
+              let context = self.context, let state = self.presentationInterfaceState,
+              let draft = state.interfaceState.mediaDraftState, case let .audio(audio) = draft,
+              self.view.window != nil else { return }
+        self.mediaPlayer?.pause()
+        let token = self.nebulaDraftGeneration, account = context.account.peerId
+        let service = self.nebulaDraftServiceKey()
+        self.nebulaDraftFetching = true
+        self.nebulaAaNode.isEnabled = false
+        self.nebulaDraftFetch.set((context.account.postbox.mediaBox.resourceData(audio.resource)
+        |> filter { $0.complete } |> take(1) |> deliverOnMainQueue).start(next: { [weak self] resource in
+            guard let self else { return }
+            self.nebulaDraftFetching = false
+            self.nebulaAaNode.isEnabled = true
+            guard self.nebulaDraftGeneration == token, self.presentationInterfaceState?.interfaceState.mediaDraftState == draft,
+                  self.context?.account.peerId == account, self.view.window != nil else { return }
+            let cached = self.nebulaDraftTranscript.flatMap { $0.generation == token && $0.service == service ? $0.text : nil }
+            context.sharedContext.presentNebulaDraftVoice(context: context, from: self.view, file: URL(fileURLWithPath: resource.path),
+                duration: audio.duration, start: audio.trimRange?.lowerBound ?? 0.0, end: audio.trimRange?.upperBound ?? audio.duration,
+                localOnly: state.renderedPeer?.peer?.id.namespace == Namespaces.Peer.SecretChat,
+                initialText: cached, changed: cached == nil && self.nebulaDraftTranscript != nil,
+                isCurrent: { [weak self] in
+                    guard let self else { return false }
+                    return self.nebulaDraftGeneration == token && self.presentationInterfaceState?.interfaceState.mediaDraftState == draft
+                        && self.context?.account.peerId == account && self.view.window != nil
+                }, remember: { [weak self] text in
+                    guard let self, self.nebulaDraftGeneration == token else { return }
+                    self.nebulaDraftTranscript = (token, self.nebulaDraftServiceKey(), text)
+                }, apply: { [weak self] text in
+                    guard let self, self.nebulaDraftGeneration == token,
+                          self.presentationInterfaceState?.interfaceState.mediaDraftState == draft,
+                          self.context?.account.peerId == account else { return }
+                    self.interfaceInteraction?.deleteRecordedMedia()
+                    self.interfaceInteraction?.updateTextInputStateAndMode { _, _ in
+                        return (ChatTextInputState(inputText: NSAttributedString(string: text)), .text)
+                    }
+                })
+        }))
+        DispatchQueue.main.asyncAfter(deadline: .now() + 10) { [weak self] in
+            guard let self, self.nebulaDraftGeneration == token, self.nebulaDraftFetching else { return }
+            self.nebulaDraftFetch.set(nil)
+            self.nebulaDraftFetching = false
+            self.nebulaAaNode.isEnabled = true
+        }
+    }
