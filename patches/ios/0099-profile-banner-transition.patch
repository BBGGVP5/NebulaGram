+    private func nebulaUpdateBanner(width: CGFloat, bottom: CGFloat, protectedBottom: CGFloat,
+                                   hasPhoto: Bool, editing: Bool, color: UIColor,
+                                   transition: ContainedViewLayoutTransition) {
+        if self.nebulaBannerColor != color {
+            self.nebulaBannerColor = color
+            CATransaction.begin()
+            CATransaction.setDisableActions(true)
+            self.nebulaBannerGradient.colors = [color.withAlphaComponent(0.0).cgColor,
+                color.withAlphaComponent(0.11).cgColor,
+                color.withAlphaComponent(0.54).cgColor, color.cgColor]
+            CATransaction.commit()
+        }
+        let frame = NebulaProfileBannerPolicy.fadeFrame(width: width, bottom: bottom,
+            protectedBottom: protectedBottom, pixel: UIScreenPixel)
+        let fadeTransition: ContainedViewLayoutTransition = UIAccessibility.isReduceMotionEnabled ? .immediate : transition
+        fadeTransition.updateFrame(node: self.nebulaBannerFade, frame: frame, beginWithCurrentState: true)
+        let gradientFrame = CGRect(origin: .zero, size: CGSize(width: frame.width, height: max(0.0, frame.height - UIScreenPixel)))
+        fadeTransition.updateFrame(layer: self.nebulaBannerGradient, frame: gradientFrame, beginWithCurrentState: true)
+        let alpha = frame.isEmpty ? 0.0 : NebulaProfileBannerPolicy.opacity(
+            style: NebulaSettingsStore.shared.profileStyle, photoBanner: NebulaSettingsStore.shared.profilePhotoBanner,
+            hasPhoto: hasPhoto, editing: editing)
+        fadeTransition.updateAlpha(node: self.nebulaBannerFade, alpha: alpha, beginWithCurrentState: true)
+    }
