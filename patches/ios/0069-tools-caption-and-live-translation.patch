+    public func presentNebulaCaptionTools(context: AccountContext, from view: UIView, text: String, apply: @escaping (String) -> Void) {
+        var responder: UIResponder? = view
+        while responder != nil && !(responder is UIViewController) { responder = responder?.next }
+        guard var presenter = responder as? UIViewController else { return }
+        while let presented = presenter.presentedViewController { presenter = presented }
+        guard !presenter.isBeingDismissed else { return }
+        let data = context.sharedContext.currentPresentationData.with { $0 }
+        let tools = NebulaMessageToolsController(text: text, russian: data.strings.baseLanguageCode.hasPrefix("ru"),
+            theme: data.theme, accountId: String(context.account.peerId.toInt64()), applyDraft: apply)
+        view.endEditing(true)
+        presenter.present(NebulaToolsNavigationController(root: tools), animated: true)
+    }
