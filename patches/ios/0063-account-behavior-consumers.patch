+private func nebulaFilteredNotification(_ original: NotificationContent, transaction: Transaction, peerId: PeerId, messageId: MessageId?, accountPeerId: PeerId, appGroupName: String) -> NotificationContent {
+    guard original.category != "t", original.category != "st", original.category != "str",
+          let prefs = UserDefaults(suiteName: appGroupName) else { return original }
+    let prefix = "nebula.behavior." + String(accountPeerId.toInt64()) + "."
+    var content = original
+    if prefs.bool(forKey: prefix + "ignore_mentions"),
+       prefs.stringArray(forKey: prefix + "mention_peers")?.contains(String(peerId.toInt64())) ?? true,
+       let messageId, let message = transaction.getMessage(messageId),
+       message.attributes.contains(where: { $0 is ConsumablePersonalMentionMessageAttribute }) {
+        return NotificationContent(isLockedMessage: nil)
+    }
+    if prefs.bool(forKey: prefix + "mute_non_contacts"), peerId.namespace == Namespaces.Peer.CloudUser,
+       peerId != accountPeerId, ![777000, 333000, 424000, 708513].contains(peerId.id._internalGetInt64Value()),
+       !transaction.isPeerContact(peerId: peerId) {
+        content.sound = nil
+    }
+    return content
+}
 
