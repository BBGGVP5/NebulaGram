@@ -361,2 +361,34 @@ public final class ChatControllerImpl: TelegramBaseController, ChatController, G
     var selectPollOptionFeedback: HapticFeedback?
+    private var nebulaSnowLayer: CAEmitterLayer?
+
+    private func nebulaUpdateSnow() {
+        self.nebulaSnowLayer?.removeFromSuperlayer()
+        self.nebulaSnowLayer = nil
+        guard UserDefaults.standard.bool(forKey: "nebula.chat.snowflakes"),
+              !UIAccessibility.isReduceMotionEnabled,
+              !ProcessInfo.processInfo.isLowPowerModeEnabled else { return }
+        let image = UIGraphicsImageRenderer(size: CGSize(width: 6, height: 6)).image { _ in
+            UIColor.white.withAlphaComponent(0.75).setFill()
+            UIBezierPath(ovalIn: CGRect(x: 1, y: 1, width: 4, height: 4)).fill()
+        }
+        let cell = CAEmitterCell()
+        cell.contents = image.cgImage
+        cell.birthRate = 3
+        cell.lifetime = 12
+        cell.velocity = 65
+        cell.velocityRange = 25
+        cell.emissionLongitude = .pi / 2
+        cell.emissionRange = .pi / 10
+        cell.scaleRange = 0.35
+        cell.alphaSpeed = -0.06
+        let layer = CAEmitterLayer()
+        layer.emitterShape = .line
+        layer.emitterMode = .surface
+        layer.emitterCells = [cell]
+        layer.frame = self.view.bounds
+        layer.emitterPosition = CGPoint(x: self.view.bounds.midX, y: 0)
+        layer.emitterSize = CGSize(width: self.view.bounds.width, height: 1)
+        self.view.layer.addSublayer(layer)
+        self.nebulaSnowLayer = layer
+    }
     
