+private func nebulaFolderTitle(_ title: ChatFolderTitle, style: Int, isAllChats: Bool) -> ChatFolderTitle {
+    guard style == 1 || style == 2 else { return title }
+
+    var icon = isAllChats ? "💬" : "📁"
+    var iconEntity: MessageTextEntity?
+    let utf16Length = (title.text as NSString).length
+    if let entity = title.entities.first(where: { entity in
+        if case .CustomEmoji = entity.type { return true }
+        return false
+    }), entity.range.lowerBound >= 0, entity.range.upperBound <= utf16Length,
+       entity.range.lowerBound < entity.range.upperBound {
+        icon = (title.text as NSString).substring(with: NSRange(location: entity.range.lowerBound, length: entity.range.count))
+        iconEntity = MessageTextEntity(range: 0..<icon.utf16.count, type: entity.type)
+    } else if let emoji = title.text.first(where: { character in
+        character.unicodeScalars.contains(where: { $0.properties.isEmojiPresentation || ($0.properties.isEmoji && $0.value > 0x2000) })
+    }) {
+        icon = String(emoji)
+    }
+
+    if style == 1 {
+        return ChatFolderTitle(text: icon, entities: iconEntity.map { [$0] } ?? [], enableAnimations: title.enableAnimations)
+    }
+    let prefix = icon + " "
+    let shift = prefix.utf16.count
+    var entities = iconEntity.map { [$0] } ?? []
+    entities.append(contentsOf: title.entities.map { entity in
+        MessageTextEntity(range: (entity.range.lowerBound + shift)..<(entity.range.upperBound + shift), type: entity.type)
+    })
+    return ChatFolderTitle(text: prefix + title.text, entities: entities, enableAnimations: title.enableAnimations)
+}
 
