+    private func nebulaFormatSelection(_ index: Int) {
+        guard !self.inputTextState.selectionRange.isEmpty else { return }
+        switch index {
+        case 0: self.formatAttributesBold(self)
+        case 1: self.formatAttributesItalic(self)
+        case 2: self.formatAttributesMonospace(self)
+        case 3: self.formatAttributesQuote(self)
+        case 4: self.formatAttributesSpoiler(self)
+        case 5: self.formatAttributesLink(self)
+        default:
+            // The native engine keeps tables, headings and lists the input state cannot
+            // express; rebuilding from that state would drop them. Its own command clears.
+            if self.performNativeFormatShortcut(.clearFormatting) {
+                return
+            }
+            self.interfaceInteraction?.updateTextInputStateAndMode { current, mode in
+                let text = NSMutableAttributedString(attributedString: current.inputText)
+                let range = NSRange(location: current.selectionRange.lowerBound, length: current.selectionRange.count)
+                guard range.location >= 0 && NSMaxRange(range) <= text.length else { return (current, mode) }
+                for key in [ChatTextInputAttributes.bold, ChatTextInputAttributes.italic, ChatTextInputAttributes.monospace,
+                    ChatTextInputAttributes.strikethrough, ChatTextInputAttributes.underline, ChatTextInputAttributes.spoiler,
+                    ChatTextInputAttributes.block, ChatTextInputAttributes.textUrl] { text.removeAttribute(key, range: range) }
+                return (ChatTextInputState(inputText: text, selectionRange: current.selectionRange), mode)
+            }
+        }
+    }
