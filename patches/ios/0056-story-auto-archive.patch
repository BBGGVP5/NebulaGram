     private(set) var orderedStorySubscriptions: EngineStorySubscriptions?
+    private var nebulaStoryArchiveObserver: NSObjectProtocol?
+    private var nebulaArchivedStoryPeerIds = Set<EnginePeer.Id>()
+
+    private func nebulaArchiveStoriesIfNeeded() {
+        guard case .chatList(groupId: .root) = self.location, let subscriptions = self.orderedStorySubscriptions else { return }
+        let prefix = "nebula.story.archive.\(self.context.account.peerId.toInt64())."
+        let defaults = UserDefaults.standard
+        guard defaults.bool(forKey: prefix + "0") else { return }
+        let archiveUsers = defaults.object(forKey: prefix + "1") == nil || defaults.bool(forKey: prefix + "1")
+        let archiveChannels = defaults.bool(forKey: prefix + "2")
+        for item in subscriptions.items {
+            let eligible: Bool
+            switch item.peer {
+            case .user: eligible = archiveUsers
+            case .channel: eligible = archiveChannels
+            default: eligible = false
+            }
+            guard eligible, !self.nebulaArchivedStoryPeerIds.contains(item.peer.id) else { continue }
+            self.nebulaArchivedStoryPeerIds.insert(item.peer.id)
+            self.context.engine.peers.updatePeerStoriesHidden(id: item.peer.id, isHidden: true)
+        }
+    }
     private var displayedStoriesTooltip: Bool = false
