+    public func canTranscribeWithNebula(message: Message) -> Bool {
+        if #available(iOS 15.0, *), NebulaAudioPreferences.shared.transcriptionEnabled {
+            return NebulaAudioTranscriptionController.eligibleFile(message) != nil
+        }
+        return false
+    }
+    public func presentNebulaAudioTranscription(context: AccountContext, from view: UIView, message: Message) {
+        guard #available(iOS 15.0, *), canTranscribeWithNebula(message: message),
+              let file = NebulaAudioTranscriptionController.eligibleFile(message) else { return }
+        var responder: UIResponder? = view
+        while responder != nil && !(responder is UIViewController) { responder = responder?.next }
+        guard var presenter = responder as? UIViewController else { return }
+        while let presented = presenter.presentedViewController { presenter = presented }
+        guard !presenter.isBeingDismissed, !presenter.isBeingPresented else { return }
+        presenter.present(NebulaToolsNavigationController(root: NebulaAudioTranscriptionController(context: context, message: message, file: file)), animated: true)
+    }
