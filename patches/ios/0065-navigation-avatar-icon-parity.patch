 NSBundle * _Nonnull getAppBundle() {
     static NSBundle *appBundle = nil;
@@ -18,10 +20,64 @@
     return appBundle;
 }
 
+// Read the validated public presentation document. Authentication and account
+// data are not consulted. Cache the integer until UserDefaults changes.
+static NSInteger NebulaSelectedIconPack(void) {
+    static atomic_int cached = -1;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        [[NSNotificationCenter defaultCenter] addObserverForName:NSUserDefaultsDidChangeNotification object:nil queue:nil usingBlock:^(__unused NSNotification *notification) {
+            atomic_store(&cached, -1);
+        }];
+    });
+    int pack = atomic_load(&cached);
+    if (pack >= 0) return pack;
+    pack = 1;
+    NSData *data = [[NSUserDefaults standardUserDefaults] dataForKey:@"app.nebulagram.presentation.settings.v1"];
+    if ([data isKindOfClass:NSData.class]) {
+        id document = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+        if ([document isKindOfClass:NSDictionary.class] && [document[@"settings"] isKindOfClass:NSDictionary.class]) {
+            id raw = document[@"settings"][@"icon_pack"];
+            if ([raw isKindOfClass:NSNumber.class]) {
+                pack = MAX(0, MIN(2, [raw intValue]));
+            } else {
+                id legacy = document[@"settings"][@"ios_icons"];
+                if ([legacy isKindOfClass:NSNumber.class]) pack = [legacy boolValue] ? 1 : 0;
+            }
+        }
+    }
+    atomic_store(&cached, pack);
+    return pack;
+}
+
 @implementation UIImage (AppBundle)
 
 - (instancetype _Nullable)initWithBundleImageName:(NSString * _Nonnull)bundleImageName {
-    return [UIImage imageNamed:bundleImageName inBundle:getAppBundle() compatibleWithTraitCollection:nil];
+    UIImage *original = [UIImage imageNamed:bundleImageName inBundle:getAppBundle() compatibleWithTraitCollection:nil];
+    NSArray<NSString *> *names = NebulaIconNames()[bundleImageName];
+    if (!original || !names) return original;
+    NSInteger pack = NebulaSelectedIconPack();
+    if (pack == 0) return original;
+    NSString *name = names[pack - 1];
+    if (name.length == 0) return original;
+    static NSCache<NSString *, UIImage *> *cache;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{ cache = [[NSCache alloc] init]; cache.countLimit = 128; });
+    NSString *key = [NSString stringWithFormat:@"%ld:%@", (long)pack, bundleImageName];
+    UIImage *cached = [cache objectForKey:key];
+    if (cached) return cached;
+    UIImage *image = [UIImage imageNamed:name inBundle:getAppBundle() compatibleWithTraitCollection:nil];
+    if (!image) return original;
+    CGSize size = original.size;
+    if (size.width <= 0.0 || size.height <= 0.0) return original;
+    CGFloat side = MIN(size.width, size.height);
+    UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc] initWithSize:size];
+    UIImage *result = [renderer imageWithActions:^(__unused UIGraphicsImageRendererContext *context) {
+        [[image imageWithRenderingMode:UIImageRenderingModeAlwaysOriginal] drawInRect:CGRectMake((size.width - side) * 0.5, (size.height - side) * 0.5, side, side)];
+    }];
+    result = [result imageWithRenderingMode:original.renderingMode];
+    [cache setObject:result forKey:key];
+    return result;
 }
 
 @end
