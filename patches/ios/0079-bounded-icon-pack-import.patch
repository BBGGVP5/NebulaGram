+// Bounded in-memory read. Never extract an imported icon archive to disk.
++ (NSData *)nebulaReadFileAtPath:(NSString *)path filePath:(NSString *)filePath maximumSize:(NSUInteger)maximumSize {
+    if (maximumSize == 0 || maximumSize > 262144) return nil;
+    unzFile file = unzOpen(path.fileSystemRepresentation);
+    if (!file) return nil;
+    if (unzLocateFile(file, filePath.UTF8String, NULL) != UNZ_OK) { unzClose(file); return nil; }
+    unz_file_info info = {};
+    char name[2048] = {0};
+    if (unzGetCurrentFileInfo(file, &info, name, sizeof(name), NULL, 0, NULL, 0) != UNZ_OK || strcmp(name, filePath.UTF8String) != 0 || info.uncompressed_size > maximumSize || (info.flag & 1) != 0 || unzOpenCurrentFile(file) != UNZ_OK) { unzClose(file); return nil; }
+    NSMutableData *data = [NSMutableData data];
+    unsigned char buffer[4096];
+    int count = 0;
+    BOOL valid = YES;
+    while ((count = unzReadCurrentFile(file, buffer, sizeof(buffer))) > 0) {
+        if (data.length + (NSUInteger)count > maximumSize) { valid = NO; break; }
+        [data appendBytes:buffer length:(NSUInteger)count];
+    }
+    if (count < 0 || data.length != info.uncompressed_size) valid = NO;
+    if (unzCloseCurrentFile(file) != UNZ_OK) valid = NO;
+    unzClose(file);
+    return valid ? data : nil;
+}
