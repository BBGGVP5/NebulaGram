+/// Where a build without an App Group keeps what the group would have held.
+///
+/// Only reached when the container is genuinely unavailable, so a properly
+/// provisioned build never takes this path and nothing about it changes.
+private func nebulaPrivateContainerUrl() -> URL? {
+    let manager = FileManager.default
+    guard let base = manager.urls(for: .applicationSupportDirectory, in: .userDomainMask).first else {
+        return nil
+    }
+    let url = base.appendingPathComponent("NebulaGramContainer", isDirectory: true)
+    if !manager.fileExists(atPath: url.path) {
+        try? manager.createDirectory(at: url, withIntermediateDirectories: true, attributes: nil)
+    }
+    return manager.fileExists(atPath: url.path) ? url : nil
+}
