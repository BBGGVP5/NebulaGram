<?xml version="1.0" encoding="utf-8"?>
<!-- Заставка запуска: тот же знак, что и на иконке, — комета со следом.
     Фон рисует тема (windowSplashScreenBackground), поэтому здесь только
     сам знак на прозрачном холсте: система накладывает свою круглую маску. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">
    <group android:scaleX="0.86" android:scaleY="0.86"
        android:pivotX="100" android:pivotY="100">
        <!-- След: две сужающиеся линии, вторая слабее — так читается движение. -->
        <path
            android:pathData="M44,148 C58,142 70,139 82,139"
            android:strokeColor="#DABBD6FF"
            android:strokeWidth="9"
            android:strokeLineCap="round" />
        <path
            android:pathData="M40,124 C49,120 57,118 65,118"
            android:strokeColor="#8CBBD6FF"
            android:strokeWidth="7"
            android:strokeLineCap="round" />
        <!-- Явные дуги сохраняют круглые углы и форму знака при системном масштабировании. -->
        <path
            android:pathData="M145.2444,46.1130 A6.5,6.5 0 0,1 153.5623,55.3632 L101.5623,141.3632 A6.5,6.5 0 0,1 89.6728,139.4888 L82.5944,109.4056 L52.5112,102.3272 A6.5,6.5 0 0,1 51.2444,90.1130 Z"
            android:fillColor="#FFEEF4FF" />
    </group>
</vector>
